{
  "name": "@ifwu/omp-next-step",
  "version": "0.5.2",
  "description": "Optional next-step drafts and private local feedback for OMP",
  "type": "module",
  "license": "MIT",
  "author": "iFwu",
  "repository": { "type": "git", "url": "git+https://github.com/iFwu/omp-extensions.git", "directory": "packages/next-step" },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "bun": ">=1.3.14" },
  "scripts": { "test": "bun test tests/*.test.ts && PYTHONPATH=../.. python3 -m unittest discover -s tests -v" },
  "omp": {
    "extensions": ["src/index.ts"],
    "settings": {
      "enabled": { "type": "boolean", "default": false, "description": "Generate optional next-step drafts" },
      "model": { "type": "string", "default": "@smol", "description": "Independent suggestion model or role" },
      "effort": { "type": "string", "default": "low", "description": "Suggestion reasoning effort" },
      "collect": { "type": "boolean", "default": true, "description": "Collect private local evaluation events" },
      "dataDir": { "type": "string", "description": "Optional private local dataset directory" }
    }
  },
  "peerDependencies": { "@oh-my-pi/pi-ai": "18.12.6", "@oh-my-pi/pi-coding-agent": "18.12.6", "@oh-my-pi/pi-tui": "18.12.6" },
  "peerDependenciesMeta": { "@oh-my-pi/pi-ai": { "optional": true }, "@oh-my-pi/pi-coding-agent": { "optional": true }, "@oh-my-pi/pi-tui": { "optional": true } }
}
