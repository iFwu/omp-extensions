{
  "name": "@ifwu/omp-secret",
  "version": "0.5.0",
  "description": "Opt-in session-only secret requests and foreground Bash references for OMP",
  "type": "module",
  "license": "MIT",
  "author": "iFwu",
  "repository": { "type": "git", "url": "git+https://github.com/iFwu/omp-extensions.git", "directory": "packages/secret" },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "bun": ">=1.3.14" },
  "scripts": { "test": "bun test tests/*.test.ts && PYTHONPATH=../.. python3 -m unittest discover -s tests -v" },
  "omp": {
    "extensions": ["src/index.ts"],
    "settings": {
      "enabled": { "type": "boolean", "default": false, "description": "Enable session-only secret requests and foreground Bash references" }
    }
  },
  "peerDependencies": { "@sinclair/typebox": "0.34.52", "@oh-my-pi/pi-ai": "18.12.6", "@oh-my-pi/pi-coding-agent": "18.12.6", "@oh-my-pi/pi-tui": "18.12.6", "@oh-my-pi/pi-utils": "18.12.6" },
  "peerDependenciesMeta": { "@sinclair/typebox": { "optional": true }, "@oh-my-pi/pi-ai": { "optional": true }, "@oh-my-pi/pi-coding-agent": { "optional": true }, "@oh-my-pi/pi-tui": { "optional": true }, "@oh-my-pi/pi-utils": { "optional": true } }
}
