{
  "name": "@ifwu/omp-extensions",
  "version": "0.4.0",
  "description": "Portable display, input, and optional next-step extensions for Oh My Pi 18.12.6",
  "type": "module",
  "license": "MIT",
  "author": "iFwu",
  "repository": { "type": "git", "url": "git+https://github.com/iFwu/omp-extensions.git" },
  "homepage": "https://github.com/iFwu/omp-extensions#readme",
  "bugs": { "url": "https://github.com/iFwu/omp-extensions/issues" },
  "keywords": ["omp", "oh-my-pi", "extension", "tui"],
  "files": ["packages/*/src/**", "packages/*/package.json", "packages/*/README.md", "packages/*/LICENSE", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "bun": ">=1.3.14" },
  "packageManager": "bun@1.4.4",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun run --workspaces --parallel --no-exit-on-error test && python3 -m unittest discover -s tests/integration -v",
    "typecheck": "tsc --noEmit",
    "preview:next-action": "python3 scripts/preview-next-action.py",
    "smoke:package": "python3 scripts/smoke-package.py"
  },
  "omp": {
    "extensions": [
      "packages/composer/src/index.ts",
      "packages/transcript-grouping/src/index.ts",
      "packages/ask-history/src/index.ts",
      "packages/skill-completion/src/index.ts",
      "packages/model-switch/src/index.ts",
      "packages/next-step/src/index.ts"
    ],
    "settings": {
      "next-step": { "type": "boolean", "default": false, "description": "Generate optional next-step drafts" },
      "next-step-model": { "type": "string", "default": "@smol", "description": "Independent next-step suggestion model or role" },
      "next-step-effort": { "type": "string", "default": "low", "description": "Next-step suggestion reasoning effort" },
      "next-step-collect": { "type": "boolean", "default": true, "description": "Collect private local next-step evaluation events" },
      "next-step-data-dir": { "type": "string", "description": "Optional private local next-step dataset directory" }
    }
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "18.12.6",
    "@oh-my-pi/pi-coding-agent": "18.12.6",
    "@oh-my-pi/pi-tui": "18.12.6"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": { "optional": true },
    "@oh-my-pi/pi-coding-agent": { "optional": true },
    "@oh-my-pi/pi-tui": { "optional": true }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.12.6",
    "@oh-my-pi/pi-coding-agent": "18.12.6",
    "@oh-my-pi/pi-tui": "18.12.6",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
